{
  "$schema": "./schema/ingotvault.config.schema.json",
  "workspaceRoot": "~/code",
  "mirrorRoot": "/Volumes/Backup/git-mirrors",
  "remoteName": "backup",
  "maxDepth": 3,
  "excludeDirNames": ["__ARCHIVE", "node_modules", ".git", ".hg"],
  "excludeRepoGlobs": [
    "sandbox/**",
    "**/vendor/**",
    "test-project"
  ],
  "pushAllBranches": true,
  "pushTags": true,
  "naming": {
    "style": "path-tree",
    "prefix": "",
    "suffix": ".git"
  },
  "safeDirectory": "per-mirror",
  "allowForceWithLease": false,
  "captureWorktree": false,
  "wipRetention": 20,
  "wipExclude": [],
  "logDir": "~/.local/share/ingotvault/logs",
  "logRetentionDays": 30
}
