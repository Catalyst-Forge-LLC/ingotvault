{
  "name": "ingotvault",
  "version": "0.1.0",
  "description": "IngotVault — spare remotes for a workspace of Git repos: push all local branches and tags to bare mirrors on a drive you control. Never touches origin.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "ingotvault": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "docs",
    "config.example.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test --test-reporter=spec src/**/*.test.ts",
    "start": "tsx src/cli.ts",
    "ingotvault": "tsx src/cli.ts",
    "list": "tsx src/cli.ts list",
    "verify": "tsx src/cli.ts verify",
    "dry-run": "tsx src/cli.ts --dry-run",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site run build",
    "site:deploy": "pnpm --dir site run deploy",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "git",
    "backup",
    "mirror",
    "bare-repository",
    "local-first",
    "workspace",
    "ingotvault"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catalyst-Forge-LLC/ingotvault.git"
  },
  "bugs": {
    "url": "https://github.com/Catalyst-Forge-LLC/ingotvault/issues"
  },
  "homepage": "https://ingotvault.dev",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
